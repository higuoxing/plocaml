-- Nested subtransactions
CREATE FUNCTION subtransaction_nested_test(swallow boolean = 'f') RETURNS text
LANGUAGE plocamlu
AS $$
  let swallow = match args.(0) with PL.Bool b -> b | _ -> false in
  ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (1)");
  PL.subtransaction (fun () ->
    ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (2)");
    (try
       PL.subtransaction (fun () ->
         ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (3)");
         ignore (PL.execute "error"))
     with Failure msg ->
       if not swallow then failwith msg
       else PL.notice (Printf.sprintf "Swallowed Failure(%S)" msg)));
  PL.String "ok"
$$;
SELECT subtransaction_nested_test();
ERROR:  syntax error at or near "error"
LINE 1: error
        ^
QUERY:  error
SELECT * FROM subtransaction_tbl ORDER BY i;
 i 
---
(0 rows)

TRUNCATE subtransaction_tbl;
SELECT subtransaction_nested_test('t');
NOTICE:  Swallowed Failure("syntax error at or near \"error\"")
 subtransaction_nested_test 
----------------------------

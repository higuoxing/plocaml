-- Nested subtransactions that recursively call code dealing with
-- subtransactions
CREATE FUNCTION subtransaction_deeply_nested_test() RETURNS text
LANGUAGE plocamlu
AS $$
  ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (1)");
  PL.subtransaction (fun () ->
    ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (2)");
    ignore (PL.execute "SELECT subtransaction_nested_test('t')"));
  PL.String "ok"
$$;
SELECT subtransaction_deeply_nested_test();
NOTICE:  Swallowed Failure("syntax error at or near \"error\"")
 subtransaction_deeply_nested_test 
-----------------------------------
 ok

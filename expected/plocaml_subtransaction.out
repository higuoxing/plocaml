CREATE FUNCTION pk_violation_inside_subtransaction() RETURNS void
LANGUAGE plocamlu
AS $$
  PL.subtransaction (fun () ->
    ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (1)");
    (try ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (1)")
     with Failure _ -> PL.notice "caught"));
  PL.Null
$$;
SELECT pk_violation_inside_subtransaction();

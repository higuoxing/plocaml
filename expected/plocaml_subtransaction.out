-- try/catch inside a subtransaction block: the caught SPI error is rolled back
-- by its implicit subtransaction, and the enclosing explicit one survives.
CREATE FUNCTION try_catch_inside_subtransaction() RETURNS void
LANGUAGE plocamlu
AS $$
  PL.subtransaction (fun () ->
    ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (1)");
    (try ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES ('a')")
     with Failure _ -> PL.notice "caught"));
  PL.Null
$$;
SELECT try_catch_inside_subtransaction();
NOTICE:  caught

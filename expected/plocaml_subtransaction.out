-- cursor/subtransaction interaction: a cursor opened inside a committed
-- subtransaction is still usable afterwards.
CREATE FUNCTION cursor_in_subxact() RETURNS int
LANGUAGE plocamlu
AS $$
  let cur = PL.subtransaction (fun () ->
    let cur = PL.cursor "select * from generate_series(1, 20) as gen(i)" in
    ignore (PL.fetch cur 10);
    cur) in
  let fetched = PL.fetch cur 10 in
  match List.assoc_opt "i" fetched.rows.(5) with
  | Some (PL.Int n) -> PL.Int n
  | _ -> PL.Null
$$;
SELECT cursor_in_subxact();
 cursor_in_subxact 
-------------------
                16
(1 row)

-- A cursor opened inside a subtransaction that then aborts is invalidated;
-- fetching from it afterwards raises a clean error rather than crashing.
CREATE FUNCTION cursor_aborted_subxact() RETURNS int
LANGUAGE plocamlu
AS $$
  let cur = ref None in
  (try
     PL.subtransaction (fun () ->
       cur := Some (PL.cursor "select * from generate_series(1, 20) as gen(i)");
       ignore (PL.fetch (Option.get !cur) 10);
       ignore (PL.execute "select no_such_function()"))
   with Failure _ ->
     let fetched = PL.fetch (Option.get !cur) 10 in
     ignore fetched);
  PL.Int 0 (* not reached *)
$$;
CREATE FUNCTION cursor_plan_aborted_subxact() RETURNS int
LANGUAGE plocamlu
AS $$
  let cur = ref None in
  (try
     PL.subtransaction (fun () ->
       ignore (PL.execute "create temporary table tmp(i) as select generate_series(1, 10)");
       let plan = PL.prepare "select i from tmp" [||] in
       cur := Some (PL.cursor_plan plan [||]);
       ignore (PL.execute "select no_such_function()"))
   with Failure _ ->
     let fetched = PL.fetch (Option.get !cur) 5 in
     ignore fetched);
  PL.Int 0 (* not reached *)
$$;
CREATE FUNCTION cursor_close_aborted_subxact() RETURNS bool
LANGUAGE plocamlu
AS $$
  let cur = ref None in
  (try
     PL.subtransaction (fun () ->
       cur := Some (PL.cursor "select 1");
       ignore (PL.execute "select no_such_function()"))
   with Failure _ ->
     PL.close (Option.get !cur));
  PL.Bool false (* not reached *)
$$;
SELECT cursor_aborted_subxact();
ERROR:  PL/OCaml execution failed
DETAIL:  Exception during execution: Failure("PL/OCaml: iterating a cursor in an aborted subtransaction")
SELECT cursor_plan_aborted_subxact();
ERROR:  PL/OCaml execution failed
DETAIL:  Exception during execution: Failure("PL/OCaml: iterating a cursor in an aborted subtransaction")
SELECT cursor_close_aborted_subxact();
ERROR:  PL/OCaml execution failed
DETAIL:  Exception during execution: Failure("PL/OCaml: closing a cursor in an aborted subtransaction")

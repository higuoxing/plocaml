-- Mix explicit subtransactions and normal (implicit) SPI calls. The explicit
-- block is all-or-nothing; the implicit block commits each statement that
-- succeeds before the failing one.
CREATE FUNCTION subtransaction_mix_explicit_and_implicit() RETURNS void
LANGUAGE plocamlu
AS $$
  (try
     PL.subtransaction (fun () ->
       ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (1)");
       ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (2)");
       ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES ('oops')"))
   with Failure _ ->
     PL.warning "Caught a SPI error from an explicit subtransaction");
  (try
     ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (1)");
     ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (2)");
     ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES ('oops')")
   with Failure _ -> PL.warning "Caught a SPI error");
  PL.Null
$$;
SELECT subtransaction_mix_explicit_and_implicit();
WARNING:  Caught a SPI error from an explicit subtransaction
WARNING:  Caught a SPI error

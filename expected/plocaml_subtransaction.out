--
-- Mirror of PL/Python's plpython_subtransaction test, adapted for PL/OCaml.
--
-- PL/OCaml exposes explicit subtransactions as
--   PL.subtransaction (fun () -> ...)
-- which commits the subtransaction if the thunk returns normally and rolls it
-- back (then re-raises) if the thunk raises. As in PL/Python, every SPI call
-- (PL.execute, PL.prepare, PL.cursor, ...) also runs inside its own implicit
-- subtransaction, so a caught error leaves the surrounding transaction usable
-- instead of aborted.
--
-- Omitted (no PL/OCaml equivalent):
--   * The __enter__/__exit__ context-manager protocol and its misuse cases
--     (enter/exit without the other, twice, alternative names): the scope-based
--     PL.subtransaction API cannot express them.
--
-- Test table to see if transactions get properly rolled back
CREATE TABLE subtransaction_tbl (
    i integer
);
-- Basic: the subtransaction commits normally, or rolls back on either an SPI
-- error or an OCaml exception.
CREATE FUNCTION subtransaction_ctx_test(what_error text = NULL) RETURNS text
LANGUAGE plocamlu
AS $$
  let what_error = match args.(0) with PL.String s -> s | _ -> "" in
  PL.subtransaction (fun () ->
    ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (1)");
    ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES (2)");
    if what_error = "SPI" then
      ignore (PL.execute "INSERT INTO subtransaction_tbl VALUES ('oops')")
    else if what_error = "OCaml" then
      failwith "OCaml exception");
  PL.Null
$$;
SELECT subtransaction_ctx_test();
 subtransaction_ctx_test 
-------------------------
 
(1 row)

SELECT * FROM subtransaction_tbl ORDER BY i;
 i 
---
 1
 2
(2 rows)

TRUNCATE subtransaction_tbl;
SELECT subtransaction_ctx_test('SPI');
ERROR:  invalid input syntax for type integer: "oops"
LINE 1: INSERT INTO subtransaction_tbl VALUES ('oops')
                                               ^
QUERY:  INSERT INTO subtransaction_tbl VALUES ('oops')
SELECT * FROM subtransaction_tbl ORDER BY i;

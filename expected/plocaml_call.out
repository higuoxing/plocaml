CREATE EXTENSION IF NOT EXISTS plocaml;
--
-- Tests for procedures / CALL syntax
--
CREATE PROCEDURE test_proc1()
LANGUAGE plocaml
AS $$
  PL.Null
$$;
CALL test_proc1();
-- error: can't return non-Null
CREATE PROCEDURE test_proc2()
LANGUAGE plocaml
AS $$
  PL.Int 5
$$;
CALL test_proc2();
ERROR:  PL/OCaml procedure did not return Null
CREATE TABLE test1 (a int);
CREATE PROCEDURE test_proc3(x int)
LANGUAGE plocaml
AS $$
  let x_val = match args.(0) with PL.Int x -> x | _ -> 0 in
  let query = "INSERT INTO test1 VALUES (" ^ string_of_int x_val ^ ")" in
  let _ = PL.execute query in
  PL.Null
$$;
CALL test_proc3(55);
SELECT * FROM test1;
 a  
----
 55
(1 row)

-- output arguments
CREATE PROCEDURE test_proc5(INOUT a text)
LANGUAGE plocaml
AS $$
  let a_str = match args.(0) with PL.String s -> s | _ -> "" in
  PL.Array [| PL.String (a_str ^ "+" ^ a_str) |]
$$;
CALL test_proc5('abc');
    a    
---------
 abc+abc
(1 row)

CREATE PROCEDURE test_proc6(a int, INOUT b int, INOUT c int)
LANGUAGE plocaml
AS $$
  let a_val = match args.(0) with PL.Int x -> x | _ -> 0 in
  let b_val = match args.(1) with PL.Int x -> x | _ -> 0 in
  let c_val = match args.(2) with PL.Int x -> x | _ -> 0 in
  PL.Array [| PL.Int (b_val * a_val); PL.Int (c_val * a_val) |]
$$;
CALL test_proc6(2, 3, 4);
 b | c 
---+---
 6 | 8
(1 row)

-- OUT parameters
CREATE PROCEDURE test_proc9(IN a int, OUT b int)
LANGUAGE plocaml
AS $$
  let a_val = match args.(0) with PL.Int x -> x | _ -> 0 in
  PL.notice ("a: " ^ string_of_int a_val);
  PL.Array [| PL.Int (a_val * 2) |]
$$;
DO $$
DECLARE _a int; _b int;
BEGIN
  _a := 10; _b := 30;
  CALL test_proc9(_a, _b);
  RAISE NOTICE '_a: %, _b: %', _a, _b;
END
$$;
NOTICE:  a: 10
NOTICE:  _a: 10, _b: 20
DROP PROCEDURE test_proc1;
DROP PROCEDURE test_proc2;
DROP PROCEDURE test_proc3;
DROP TABLE test1;
